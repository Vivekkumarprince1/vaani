# Copy to /etc/vaani/monitoring.env on OCI. Never commit the real file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
GRAFANA_ROOT_URL=http://localhost:3000
PROMETHEUS_RETENTION=15d

# Must match backend METRICS_TOKEN in /etc/vaani/backend.env.
PROMETHEUS_BACKEND_METRICS_TOKEN=replace-with-a-long-random-token

# Use private OCI endpoints. Do not use public database/Redis endpoints.
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://monitoring:password@postgres.internal:5432/vaani_v2?sslmode=require
REDIS_EXPORTER_REDIS_ADDR=redis://redis.internal:6379
REDIS_EXPORTER_REDIS_USER=
REDIS_EXPORTER_REDIS_PASSWORD=
