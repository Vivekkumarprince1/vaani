# Example environment file for backend
# Copy this to .env and fill in real values. Do NOT commit your real .env.

# API URL for client-side requests
NEXT_PUBLIC_API_URL=/api

# Socket.IO Server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Azure Translator Configuration
AZURE_TRANSLATOR_KEY=YOUR_AZURE_TRANSLATOR_KEY
AZURE_TRANSLATOR_REGION=YOUR_AZURE_REGION
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# Microsoft Azure Speech to Text Configuration
AZURE_SPEECH_KEY=YOUR_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=YOUR_AZURE_REGION
AZURE_SPEECH_ENDPOINT=https://<region>.api.cognitive.microsoft.com/sts/v1.0/issuetoken

# Server Configuration
NODE_ENV=development
PORT=3001
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=86400000

# MongoDB Connection (use a safe URI without plaintext credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mydb?retryWrites=true&w=majority

# CORS Configuration
ALLOWED_ORIGINS=https://example.com,https://your-frontend.vercel.app

# Redis Configuration (required for Socket.IO scaling)
# For Render: use Render's Redis addon or external service like Redis Cloud
REDIS_URL=redis://localhost:6379

# LiveKit Configuration (required for group video calls)
LIVEKIT_URL=wss://your-livekit-instance.com
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Socket.IO Configuration
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=30000
SOCKET_MAX_HTTP_BUFFER_SIZE=10000000
ALLOW_ALL_CORS=false

# Translation stream protection
# 16kHz mono Int16 PCM is ~32000 bytes/sec; 65536 leaves room for jitter.
TRANSLATION_STREAM_MAX_BYTES_PER_SECOND=65536
TRANSLATION_STREAM_IDLE_TIMEOUT_MS=60000

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=30000
SOCKET_PING_INTERVAL=25000

# Logging Configuration
LOG_LEVEL=info
