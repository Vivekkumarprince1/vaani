ENV=production
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
REDIS_URL=redis://default:PASSWORD@HOST:6379
JWT_SECRET=replace-with-at-least-32-random-characters
CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
ALLOWED_ORIGINS=https://app.example.com
# Optional: scoped Vercel preview suffixes, never a global *.vercel.app rule.
ALLOWED_ORIGIN_SUFFIXES=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Optional provider/media integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
